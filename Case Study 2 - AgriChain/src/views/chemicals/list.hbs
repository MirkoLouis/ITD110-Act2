{{!-- This is the Homepage. It allows users to manage their chemical inventory 
      and start a "Trace" to see where their products are going. --}}

<section class="card">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2>AgriChemical Management</h2>
        
        {{!-- Data Management: These buttons allow us to save our database progress as 
              a JSON file or restore it later. The logic for this is in src/app.js. --}}
        <div style="display: flex; gap: 0.5rem;">
            <a href="/api/backup" class="btn" style="background-color: var(--secondary-color); color: var(--text-color); border: 1px solid var(--border-color);">📥 Download JSON Backup</a>
            <form action="/api/restore" method="POST" enctype="multipart/form-data" style="display: flex; gap: 0.5rem; margin-bottom: 0;">
                <input type="file" name="backupFile" accept=".json" required style="margin-bottom: 0; width: auto; font-size: 0.8rem; padding: 0.5rem;">
                <button type="submit" class="btn" style="background-color: var(--primary-light);">📤 Restore Data</button>
            </form>
        </div>
    </div>
</section>

{{!-- If a user just restored a backup, we show this success message. --}}
{{#if restored}}
    <section class="card" style="background-color: var(--success-color); color: white; border: none; padding: 1rem;">
        <strong>✓ Success!</strong> The graph database has been successfully restored from the backup file.
    </section>
{{/if}}

{{!-- Quick Trace: This is the starting point for our main feature. 
      Entering a Batch ID here triggers the analysis logic in src/app.js. --}}
<section class="card" style="border: 2px solid var(--primary-light);">
    <h3>Quick Trace / Affected Area Analysis</h3>
    <p>Select a chemical below or enter a Batch ID to visualize its supply chain lineage.</p>
    <form action="/trace" method="GET" style="display: flex; gap: 1rem; margin-top: 1rem;">
        <input type="text" name="batchId" placeholder="e.g., CHEM-BKN-001" required style="margin-bottom: 0;">
        <button type="submit" class="btn">Analyze Lineage</button>
    </form>
</section>

<section class="dashboard-grid">
    {{!-- Create Form: This sends data to the POST /chemicals route in src/app.js 
          to add a new node to our Neo4j database. --}}
    <div class="card">
        <h3>Add New Chemical Batch</h3>
        <form action="/chemicals" method="POST">
            <input type="text" name="batch_id" placeholder="Batch ID (e.g. CHEM-5512)" required>
            <input type="text" name="type" placeholder="Type (Fertilizer/Pesticide)" required>
            <input type="text" name="manufacturer" placeholder="Manufacturer" required>
            <select name="status" style="width: 100%; padding: 0.75rem; margin-bottom: 1rem;">
                <option value="OK">OK</option>
                <option value="RECALLED">RECALLED</option>
            </select>
            <button type="submit" class="btn">Add Chemical</button>
        </form>
    </div>

    {{!-- Inventory Table: We use a Handlebars loop ({{#each}}) to display every 
          chemical that was fetched from the database in src/app.js. --}}
    <div class="card">
        <h3>Existing Inventory</h3>
        <table style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
            <thead>
                <tr style="text-align: left; border-bottom: 2px solid var(--border-color);">
                    <th>Batch ID</th>
                    <th>Type</th>
                    <th>Manufacturer</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#each chemicals}}
                <tr style="border-bottom: 1px solid var(--border-color);">
                    <td style="padding: 0.5rem 0;"><strong>{{this.batch_id}}</strong></td>
                    <td>{{this.type}}</td>
                    <td>{{this.manufacturer}}</td>
                    <td>
                        {{!-- We use a color code: Red for RECALLED, Green for OK. --}}
                        <span style="color: {{#if (eq this.status 'RECALLED')}}var(--danger-color){{else}}var(--success-color){{/if}};">
                            {{this.status}}
                        </span>
                    </td>
                    <td>
                        <div style="display: flex; gap: 0.5rem;">
                            {{!-- This link takes us to the Tracing results page. --}}
                            <a href="/trace?batchId={{this.batch_id}}" class="btn" style="padding: 0.25rem 0.5rem; font-size: 0.8rem; background-color: var(--primary-light); text-decoration: none;">Trace Path</a>
                            
                            {{!-- Toggle Status: Quickly switch between OK and RECALLED. --}}
                            <form action="/chemicals/update-status" method="POST" style="display: inline;">
                                <input type="hidden" name="batch_id" value="{{this.batch_id}}">
                                <input type="hidden" name="status" value="{{#if (eq this.status 'RECALLED')}}OK{{else}}RECALLED{{/if}}">
                                <button type="submit" class="btn" style="padding: 0.25rem 0.5rem; font-size: 0.8rem;">Toggle Status</button>
                            </form>

                            {{!-- Delete: Removes the chemical from our Neo4j database. --}}
                            <form action="/chemicals/delete" method="POST" style="display: inline;">
                                <input type="hidden" name="batch_id" value="{{this.batch_id}}">
                                <button type="submit" class="btn" style="padding: 0.25rem 0.5rem; font-size: 0.8rem; background-color: var(--danger-color);">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</section>
