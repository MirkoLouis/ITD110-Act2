<section class="card">
    <h2>Supply Chain Dashboard</h2>
    <p>Welcome to the AgriChain Traceability System.</p>
</section>

<section class="grid">
    <div class="card">
        <h3>Trace Contamination</h3>
        <p>Enter an AgriChemical Batch ID to trigger a "Blast Radius" analysis.</p>
        <form action="/trace" method="GET">
            <input type="text" name="batchId" placeholder="e.g., CHEM-9942" required>
            <button type="submit" class="btn">Analyze Blast Radius</button>
        </form>
    </div>
</section>
